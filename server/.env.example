# Required: your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Optional: shared secret the app must send as "Authorization: Bearer <token>".
# Set this before deploying anywhere public so strangers can't spend your API credits.
APP_TOKEN=
# Optional: model override. Defaults to claude-opus-5-5.
# claude-haiku-5-5 is much cheaper per scan if accuracy holds up for you.
CLAUDE_MODEL=
PORT=8787
